SPREADSHEET_ID=replace-with-your-spreadsheet-id
WEBHOOK_SECRET=replace-with-a-random-private-secret
GOOGLE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY=replace-with-your-service-account-private-key

# Local deployment-check command only; not required by the backend health API.
WEBHOOK_URL=https://your-project.vercel.app/api/transaction



# Optional interest module: loan ledger, separate from bank SPREADSHEET_ID.
INTEREST_SPREADSHEET_ID=

# Keep disabled until owner-approved backup, audit preparation and isolated acceptance.
LOAN_WRITES_ENABLED=0
TRANSACTION_EDITS_ENABLED=0

# Category memory (rule-based suggestions). Reads need ENABLED; rule edits also need WRITES_ENABLED + Category_Memory tab.
CATEGORY_MEMORY_ENABLED=0
CATEGORY_MEMORY_WRITES_ENABLED=0
