{
  "name": "finance-bridge-vercel-v3",
  "version": "3.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "test": "node --experimental-strip-types --import ./tests/register-ts.mjs --test \"tests/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "sheets:bootstrap": "node --env-file=.env.local --import tsx scripts/bootstrap-sheets.ts",
    "check:deployment": "node --env-file=.env.local --import tsx scripts/check-deployment.ts",
    "moneylover:import": "node --env-file-if-exists=.env.local --import tsx scripts/import-moneylover.ts",
    "transactions:migrate": "node --env-file-if-exists=.env.local --import tsx scripts/migrate-transactions.ts",
    "audit:prepare": "node --env-file-if-exists=.env.local --import tsx scripts/prepare-finance-audit.ts",
    "loans:import": "node --env-file-if-exists=.env.local --import tsx scripts/import-loans.ts",
    "own-account:digest": "node --env-file-if-exists=.env.local --import tsx scripts/own-account-digest.ts"
  },
  "dependencies": {
    "googleapis": "^144.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}

